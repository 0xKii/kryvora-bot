# ============================================================
#  Kryvora campaign bot — configuration
#  cp .env.example .env  then fill PRIVATE_KEY / WALLETS
# ============================================================

# --- wallets -------------------------------------------------
# Option A: single key
PRIVATE_KEY=
# Option B: many keys, comma separated
# PRIVATE_KEYS=0xaaa...,0xbbb...
# Option C: JSON array (what --gen prints). Takes priority.
# WALLETS=[{"pk":"0x...","evm_address":"0x..."}]

# --- captcha (Cloudflare Turnstile on the faucet) ------------
# https://2captcha.com — ~$0.003 per Turnstile solve
TWOCAPTCHA_KEY=

# --- optional: bridge Sepolia ETH -> Kryvora -----------------
# needs a funded Sepolia EOA (0.01 ETH + gas). Leave empty to skip.
SEPOLIA_PRIVATE_KEY=
BRIDGE_AMOUNT_ETH=0.01

# --- optional overrides --------------------------------------
KRYVORA_RPC=https://rpc-testnet.kryvora.network
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
ARB_RPC=https://arb1.arbitrum.io/rpc
# SWAP_TOKEN=0x8956e3f2663E033EdbC9656b7509D2657e34db00   # KALPHA (default) | KBETA 0x60624B...
# SWAP_ETH=0.0003                                         # ETH in per swap (auto-clamped to balance)
# LP_ETH=0.0003                                           # ETH in per addLiquidityETH
# FORGE_BIN=~/.foundry/bin/forge
# REFERRAL_CODE=
#
# The faucet is limited per IP AND per address (0.001 ETH / 24 h), so every wallet
# needs its own exit IP. Set PROXY to a rotating residential gateway; --fund rotates
# the sticky session per wallet automatically.
# PROXY_STICKY=true enables the sticky-suffix rotation (DataImpulse style:
#   user__cr.us;sessid.sX;sesstime.15). Leave off for gateways that rotate per connection.
# PROXY_STICKY=true
PROXY=

# --- loop control --------------------------------------------
AUTO_LOOP=false
DELAY_AFTER_CYCLE=86400
DELAY_BETWEEN_WALLETS=15

# --- paid quest (real money — left OFF on purpose) -----------
# Genesis Node Key: 10 USDC on Arbitrum One -> +120,000 PTS.
# NODE_KEY_CONTRACT=0xBCf2cD12D1D37578fA7C69805fE77788e866BE1a
